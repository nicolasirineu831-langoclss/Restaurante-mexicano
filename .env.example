# Banco PostgreSQL (no Render, use a connection string do banco criado)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/coyote
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo
# URL pública do site (usada no sitemap)
PUBLIC_URL=http://localhost:3000
# E-mail de recuperação de senha (Resend). Use um domínio verificado em MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=Coyote <nao-responda@seudominio.com.br>
# Primeiro administrador (usado apenas pelo comando npm run seed)
ADMIN_EMAIL=dono@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres
