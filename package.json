{
  "name": "coyote-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "prisma db push --skip-generate && node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "seed:demo": "node prisma/seed.js --demo",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "prisma": "^6.0.0",
    "zod": "^3.23.8"
  }
}
